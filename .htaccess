# Apache 2.4 configuration for Combell Shared Hosting (PHP-FPM compatible)
Options -Indexes

# Custom Error Pages
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# Block access to sensitive project, database, and configuration files
<FilesMatch "(^\.|^composer\.(json|lock)$|\.sql$|\.log$|\.md$|^install\.txt$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct HTTP access to internal directories
    RewriteRule ^(\.git|includes|vendor)(/|$) - [F,L]

    # Enforce HTTPS in production (skipped on localhost / 127.0.0.1)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Dynamic XML sitemap route
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"

    # Cache static fonts & optimized images
    <FilesMatch "\.(woff2|webp|jpg|jpeg|png|gif|ico)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>
