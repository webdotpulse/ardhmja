Options -Indexes

<FilesMatch "\.(?i:php[0-9]?|phtml|phar|inc|pl|py|cgi|sh|shtml|asp|aspx|jsp|svg|html?|js|css|swf|xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; script-src 'none'"
</IfModule>
